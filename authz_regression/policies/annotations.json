{
  "version": 1,
  "name": "annotation-permissions",
  "base_url": "http://127.0.0.1:8765",
  "timeout_seconds": 2,
  "max_duration_seconds": 30,
  "actors": {
    "anonymous": {"headers": {}},
    "a-owner": {"headers": {"Authorization": {"env": "DEMO_A_OWNER", "prefix": "Bearer "}}},
    "a-peer": {"headers": {"Authorization": {"env": "DEMO_A_PEER", "prefix": "Bearer "}}},
    "a-admin": {"headers": {"Authorization": {"env": "DEMO_A_ADMIN", "prefix": "Bearer "}}},
    "b-owner": {"headers": {"Authorization": {"env": "DEMO_B_OWNER", "prefix": "Bearer "}}}
  },
  "resources": {"doc": "d-a", "other_doc": "d-b", "own": "a-a", "peer": "a-peer", "other": "a-b"},
  "cases": [
    {"id": "anonymous-denied", "actor": "anonymous", "method": "GET", "path": "/documents/{doc}/annotations/{own}", "status": 401,
     "assertions": [{"pointer": "/resource", "op": "absent"}]},
    {"id": "owner-read", "actor": "a-owner", "method": "GET", "path": "/documents/{doc}/annotations/{own}", "status": 200,
     "assertions": [{"pointer": "/resource/id", "op": "equals", "value": "a-a"}, {"pointer": "/resource/owner", "op": "equals", "value": "alice"}]},
    {"id": "same-tenant-read", "actor": "a-peer", "method": "GET", "path": "/documents/{doc}/annotations/{own}", "status": 200,
     "assertions": [{"pointer": "/resource/document", "op": "equals", "value": "d-a"}]},
    {"id": "cross-tenant-read", "actor": "a-owner", "method": "GET", "path": "/documents/{other_doc}/annotations/{other}", "status": 403,
     "assertions": [{"pointer": "/resource", "op": "absent"}, {"pointer": "/error", "op": "equals", "value": "forbidden"}]},
    {"id": "parent-resource-mismatch", "actor": "a-owner", "method": "GET", "path": "/documents/{doc}/annotations/{other}", "status": 404,
     "assertions": [{"pointer": "/resource", "op": "absent"}]},
    {"id": "tenant-list", "actor": "a-owner", "method": "GET", "path": "/documents/{doc}/annotations", "status": 200,
     "assertions": [{"pointer": "/items", "op": "length", "value": 2}, {"pointer": "/items/*/document", "op": "all_equals", "value": "d-a"}, {"pointer": "/items/*/tenant", "op": "all_equals", "value": "A"}]},
    {"id": "owner-edit", "actor": "a-owner", "method": "PATCH", "path": "/documents/{doc}/annotations/{own}", "body": {"text": "Owner revision"}, "status": 200,
     "assertions": [{"pointer": "/resource/text", "op": "equals", "value": "Owner revision"}, {"pointer": "/resource/version", "op": "equals", "value": 1}]},
    {"id": "admin-same-tenant-edit", "actor": "a-admin", "method": "PATCH", "path": "/documents/{doc}/annotations/{peer}", "body": {"text": "Moderated note"}, "status": 200,
     "assertions": [{"pointer": "/resource/text", "op": "equals", "value": "Moderated note"}]},
    {"id": "cross-tenant-write", "actor": "a-owner", "method": "PATCH", "path": "/documents/{other_doc}/annotations/{other}", "body": {"text": "Unwanted edit"}, "status": 403,
     "assertions": [{"pointer": "/resource", "op": "absent"}],
     "unchanged": {"actor": "b-owner", "path": "/documents/{other_doc}/annotations/{other}", "pointer": "/resource", "status": 200}},
    {"id": "peer-write-denied", "actor": "a-peer", "method": "PATCH", "path": "/documents/{doc}/annotations/{own}", "body": {"text": "Unwanted peer edit"}, "status": 403,
     "assertions": [{"pointer": "/resource", "op": "absent"}],
     "unchanged": {"actor": "a-owner", "path": "/documents/{doc}/annotations/{own}", "pointer": "/resource", "status": 200}},
    {"id": "admin-cross-tenant-write", "actor": "a-admin", "method": "PATCH", "path": "/documents/{other_doc}/annotations/{other}", "body": {"text": "Unwanted admin edit"}, "status": 403,
     "assertions": [{"pointer": "/resource", "op": "absent"}],
     "unchanged": {"actor": "b-owner", "path": "/documents/{other_doc}/annotations/{other}", "pointer": "/resource", "status": 200}}
  ]
}
